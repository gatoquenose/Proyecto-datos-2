{
  "name": "tecflix-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "gen:api": "openapi-typescript ../docs/openapi/users.yaml -o src/types/generated/users.ts && openapi-typescript ../docs/openapi/metadata.yaml -o src/types/generated/metadata.ts && openapi-typescript ../docs/openapi/streaming.yaml -o src/types/generated/streaming.ts",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@tanstack/react-query": "^5.104.5",
    "msw": "^2.15.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "shaka-player": "^5.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^24.1.3",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.72.0",
    "vite": "^5.4.2",
    "vitest": "^2.1.9"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
